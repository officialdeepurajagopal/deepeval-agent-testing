# Copy this file to ".env" and fill in your real keys.
# Or just export them in your shell before running.

# Used by the agents and by the DeepEval judge (Claude Sonnet 4.6)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: stream traces to the Confident AI dashboard
CONFIDENT_API_KEY=confident_us_your-key-here

# Optional: only needed for the older exercises in evals/ that use GPT-4o judges
OPENAI_API_KEY=sk-your-key-here
